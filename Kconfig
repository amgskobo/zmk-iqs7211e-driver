menuconfig IQS7211E
  bool "IQS7211E Trackpad"
  select ZMK_POINTING
  select I2C
  select GPIO
  help
    Enable driver for IQS7211E.

if IQS7211E

config IQS7211E_FILTER_BYPASS
  bool "Bypass host coordinate filtering for diagnostic comparisons"
  default n
  help
    Pass valid normalized coordinates without the host deadband or three-point
    median, and report relative deltas without the two-delta average. Sensor
    register filtering, validity checks, rotation, contact lifecycle and gesture
    handling remain unchanged. This applies to both report modes and every
    IQS7211E device; leave disabled for the existing production behavior.

config IQS7211E_WORKQUEUE_STACK_SIZE
  int "IQS7211E work queue stack size"
  default 1536
  range 1024 4096
  help
    Stack size in bytes for the driver-owned work queue. The queue serializes
    sensor reads, input reports, generated clicks, touch verification, and
    suspend-time releases.

config IQS7211E_WORKQUEUE_PRIORITY
  int "IQS7211E work queue priority"
  default -1 if NUM_COOP_PRIORITIES > 0
  default 0
  range -16 15
  help
    Priority used by the driver-owned work queue. The default is cooperative
    -1, or preemptive 0 when cooperative priorities are unavailable. The selected
    priority must fit the kernel's configured priority counts. This keeps RDY
    servicing prompt. If the input message queue fills, blocking
    input reports let the input thread run and drain it without dropping an
    event.

config IQS7211E_PM_EARLY_INIT_PRIORITY
  int "Init priority of the early suspend device"
  default 45
  depends on PM_DEVICE
  help
    POST_KERNEL priority of a small device that suspends every IQS7211E
    while its I2C bus still works when ZMK powers off through &soft_off.
    That path suspends devices in init order, and the sensor's own device
    comes after the bus, where it cannot reach the sensor any more: without
    this the sensor stays awake, at its active current, for as long as the
    keyboard is off. Must be below I2C_INIT_PRIORITY.

endif

config ZMK_IQS7211E_DRIVER_LOG_LEVEL
    int "zmk-iqs7211e-driver log level (0 off, 1 error, 2 warning, 3 info, 4 debug)"
    range 0 4
    default 3
    help
      Logs contain operational state and numeric diagnostics, never input
      contents, user labels, peer addresses or authentication material.
